{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transactrx.com/ncpdp/schemas/response/priorAuthorizationRequestOnly.json",
  "title": "NCPDP Prior Authorization Request Only Response (P4)",
  "description": "Prior Authorization Request Only Response Transaction",
  "type": "object",
  "properties": {
    "Header": {
      "type": "object",
      "properties": {
        "Value": {
          "type": "object",
          "properties": {
            "Version": { "type": "string", "maxLength": 2, "description": "Version/Release Number (D0 or F6)" },
            "TransactionCode": { "type": "string", "const": "P4" },
            "RecordCount": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Transaction Count (D.0 allows 1-4 claims per transmission; F6 allows exactly 1)" },
            "Status": { "type": "string", "maxLength": 1 },
            "ServiceProviderIdQualifier": { "type": "string", "maxLength": 2 },
            "ServiceProviderId": { "type": "string", "maxLength": 15 },
            "DateOfService": { "type": "string", "pattern": "^[0-9]{8}$" }
          }
        }
      }
    },
    "Message": { "$ref": "../ncpdp-schemas.json#/$defs/response.Message" },
    "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } },
    "Authorizations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "Status": { "$ref": "../ncpdp-schemas.json#/$defs/response.Status" },
          "Claim": { "$ref": "../ncpdp-schemas.json#/$defs/response.Claim" },
          "PriorAuthorization": { "$ref": "../ncpdp-schemas.json#/$defs/response.PriorAuthorization" },
          "CoordinationOfBenefits": { "$ref": "../ncpdp-schemas.json#/$defs/response.CoordinationOfBenefits" },
          "Provider": { "$ref": "../ncpdp-schemas.json#/$defs/response.Provider" },
          "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } }
        }
      }
    }
  },
  "required": ["Header", "Authorizations"]
}
