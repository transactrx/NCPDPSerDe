{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transactrx.com/ncpdp/schemas/response/billing.json",
  "title": "NCPDP Billing Response (B1)",
  "description": "Billing Response Transaction - Response to billing request",
  "type": "object",
  "properties": {
    "Header": {
      "type": "object",
      "description": "NCPDP Response Header",
      "properties": {
        "Value": {
          "type": "object",
          "properties": {
            "Version": { "type": "string", "maxLength": 2, "description": "Version/Release Number (D0 or F6)" },
            "TransactionCode": { "type": "string", "const": "B1" },
            "RecordCount": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Transaction Count (D.0 allows 1-4 claims per transmission; F6 allows exactly 1)" },
            "Status": { "type": "string", "maxLength": 1, "description": "Header Response Status (A=Accepted, R=Rejected)" },
            "ServiceProviderIdQualifier": { "type": "string", "maxLength": 2 },
            "ServiceProviderId": { "type": "string", "maxLength": 15 },
            "DateOfService": { "type": "string", "pattern": "^[0-9]{8}$" }
          },
          "required": ["Version", "TransactionCode", "RecordCount", "Status", "ServiceProviderIdQualifier", "ServiceProviderId", "DateOfService"]
        }
      }
    },
    "Message": { "$ref": "../ncpdp-schemas.json#/$defs/response.Message" },
    "Insurance": { "$ref": "../ncpdp-schemas.json#/$defs/response.Insurance" },
    "Patient": { "$ref": "../ncpdp-schemas.json#/$defs/response.Patient" },
    "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } },
    "Claims": {
      "type": "array",
      "maxItems": 4,
      "description": "Claim response records (D.0 allows up to 4 per transaction; F6 allows exactly 1)",
      "items": {
        "type": "object",
        "properties": {
          "Status": { "$ref": "../ncpdp-schemas.json#/$defs/response.Status" },
          "Claim": { "$ref": "../ncpdp-schemas.json#/$defs/response.Claim" },
          "Pricing": { "$ref": "../ncpdp-schemas.json#/$defs/response.Pricing" },
          "Dur": { "$ref": "../ncpdp-schemas.json#/$defs/response.Dur" },
          "PriorAuthorization": { "$ref": "../ncpdp-schemas.json#/$defs/response.PriorAuthorization" },
          "CoordinationOfBenefits": { "$ref": "../ncpdp-schemas.json#/$defs/response.CoordinationOfBenefits" },
          "Intermediary": { "$ref": "../ncpdp-schemas.json#/$defs/response.Intermediary" },
          "OtherRelatedBenefitDetail": { "$ref": "../ncpdp-schemas.json#/$defs/response.OtherRelatedBenefitDetail" },
          "Provider": { "$ref": "../ncpdp-schemas.json#/$defs/response.Provider" },
          "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } }
        }
      }
    }
  },
  "required": ["Header", "Claims"]
}
