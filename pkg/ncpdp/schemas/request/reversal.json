{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transactrx.com/ncpdp/schemas/request/reversal.json",
  "title": "NCPDP Reversal Request (B2)",
  "description": "Reversal Request Transaction - Used to reverse a previously submitted billing transaction",
  "type": "object",
  "properties": {
    "Header": {
      "type": "object",
      "description": "NCPDP Request Header",
      "properties": {
        "RawValue": { "type": "string" },
        "Size": { "type": "integer" },
        "Value": {
          "type": "object",
          "properties": {
            "Bin": { "type": "string", "maxLength": 6 },
            "Version": { "type": "string", "maxLength": 2 },
            "TransactionCode": { "type": "string", "const": "B2" },
            "Pcn": { "type": "string", "maxLength": 10 },
            "RecordCount": { "type": "integer", "minimum": 1, "maximum": 4 },
            "ServiceProviderIdQualifier": { "type": "string", "maxLength": 2 },
            "ServiceProviderId": { "type": "string", "maxLength": 15 },
            "DateOfService": { "type": "string", "pattern": "^[0-9]{8}$" },
            "SoftwareVendorCertificationId": { "type": "string", "maxLength": 10 }
          },
          "required": ["Bin", "Version", "TransactionCode", "RecordCount", "ServiceProviderIdQualifier", "ServiceProviderId", "DateOfService"]
        }
      }
    },
    "Insurance": { "$ref": "../ncpdp-schemas.json#/$defs/request.Insurance" },
    "DynamicSegments": {
      "type": "array",
      "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" }
    },
    "Claims": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "Raw": { "type": "string" },
          "Claim": { "$ref": "../ncpdp-schemas.json#/$defs/request.Claim" },
          "Pricing": { "$ref": "../ncpdp-schemas.json#/$defs/request.Pricing" },
          "CoordinationOfBenefits": { "$ref": "../ncpdp-schemas.json#/$defs/request.CoordinationOfBenefits" },
          "Dur": { "$ref": "../ncpdp-schemas.json#/$defs/request.Dur" },
          "DataCollection": { "$ref": "../ncpdp-schemas.json#/$defs/request.DataCollection" },
          "DynamicSegments": {
            "type": "array",
            "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" }
          }
        }
      }
    }
  },
  "required": ["Header", "Insurance", "Claims"]
}
