{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transactrx.com/ncpdp/schemas/request/controlledSubstanceReporting.json",
  "title": "NCPDP Controlled Substance Reporting Request (C1)",
  "description": "Controlled Substance Reporting Request Transaction",
  "type": "object",
  "properties": {
    "Header": {
      "type": "object",
      "properties": {
        "RawValue": { "type": "string" },
        "Size": { "type": "integer" },
        "Value": {
          "type": "object",
          "properties": {
            "Bin": { "type": "string", "maxLength": 6 },
            "Version": { "type": "string", "maxLength": 2 },
            "TransactionCode": { "type": "string", "const": "C1" },
            "Pcn": { "type": "string", "maxLength": 10 },
            "RecordCount": { "type": "integer", "minimum": 1, "maximum": 4 },
            "ServiceProviderIdQualifier": { "type": "string", "maxLength": 2 },
            "ServiceProviderId": { "type": "string", "maxLength": 15 },
            "DateOfService": { "type": "string", "pattern": "^[0-9]{8}$" },
            "SoftwareVendorCertificationId": { "type": "string", "maxLength": 10 }
          }
        }
      }
    },
    "Patient": { "$ref": "../ncpdp-schemas.json#/$defs/request.Patient" },
    "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } },
    "Claims": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "Raw": { "type": "string" },
          "Claim": { "$ref": "../ncpdp-schemas.json#/$defs/request.Claim" },
          "Pharmacy": { "$ref": "../ncpdp-schemas.json#/$defs/request.PharmacyProvider" },
          "Prescriber": { "$ref": "../ncpdp-schemas.json#/$defs/request.Prescriber" },
          "DataCollection": { "$ref": "../ncpdp-schemas.json#/$defs/request.DataCollection" },
          "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } }
        }
      }
    }
  },
  "required": ["Header", "Patient", "Claims"]
}
