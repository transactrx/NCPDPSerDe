{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transactrx.com/ncpdp/schemas/request/priorAuthorizationReversal.json",
  "title": "NCPDP Prior Authorization Reversal Request (P2)",
  "description": "Prior Authorization Reversal Request Transaction",
  "type": "object",
  "properties": {
    "Header": {
      "type": "object",
      "properties": {
        "Value": {
          "type": "object",
          "properties": {
            "Bin": { "type": "string", "maxLength": 8, "description": "BIN Number (D.0, 6 characters) or IIN (F6, 8 characters)" },
            "Version": { "type": "string", "maxLength": 2, "description": "Version/Release Number (D0 or F6)" },
            "TransactionCode": { "type": "string", "const": "P2" },
            "Pcn": { "type": "string", "maxLength": 10 },
            "RecordCount": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Transaction Count (D.0 allows 1-4 claims per transmission; F6 allows exactly 1)" },
            "ServiceProviderIdQualifier": { "type": "string", "maxLength": 2 },
            "ServiceProviderId": { "type": "string", "maxLength": 15 },
            "DateOfService": { "type": "string", "pattern": "^[0-9]{8}$" },
            "SoftwareVendorCertificationId": { "type": "string", "maxLength": 10 }
          }
        }
      }
    },
    "Insurance": { "$ref": "../ncpdp-schemas.json#/$defs/request.Insurance" },
    "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } },
    "Authorizations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "Authorization": { "$ref": "../ncpdp-schemas.json#/$defs/request.PriorAuthorizationRequestAndBilling" },
          "DataCollection": { "$ref": "../ncpdp-schemas.json#/$defs/request.DataCollection" },
          "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } }
        }
      }
    }
  },
  "required": ["Header", "Insurance", "Authorizations"]
}
