{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transactrx.com/ncpdp/schemas/request/controlledSubstanceReportingRebill.json",
  "title": "NCPDP Controlled Substance Reporting Rebill Request (C2)",
  "description": "Controlled Substance Reporting Rebill Request Transaction",
  "type": "object",
  "properties": {
    "Header": {
      "type": "object",
      "properties": {
        "Value": {
          "type": "object",
          "properties": {
            "Bin": { "type": "string", "maxLength": 8, "description": "BIN Number (D.0, 6 characters) or IIN (F6, 8 characters)" },
            "Version": { "type": "string", "maxLength": 2, "description": "Version/Release Number (D0 or F6)" },
            "TransactionCode": { "type": "string", "const": "C2" },
            "Pcn": { "type": "string", "maxLength": 10 },
            "RecordCount": { "type": "integer", "minimum": 1, "maximum": 4, "description": "Transaction Count (D.0 allows 1-4 claims per transmission; F6 allows exactly 1)" },
            "ServiceProviderIdQualifier": { "type": "string", "maxLength": 2 },
            "ServiceProviderId": { "type": "string", "maxLength": 15 },
            "DateOfService": { "type": "string", "pattern": "^[0-9]{8}$" },
            "SoftwareVendorCertificationId": { "type": "string", "maxLength": 10 }
          }
        }
      }
    },
    "Patient": { "$ref": "../ncpdp-schemas.json#/$defs/request.Patient" },
    "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } },
    "Claims": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "Claim": { "$ref": "../ncpdp-schemas.json#/$defs/request.Claim" },
          "Pharmacy": { "$ref": "../ncpdp-schemas.json#/$defs/request.PharmacyProvider" },
          "Prescriber": { "$ref": "../ncpdp-schemas.json#/$defs/request.Prescriber" },
          "DataCollection": { "$ref": "../ncpdp-schemas.json#/$defs/request.DataCollection" },
          "DynamicSegments": { "type": "array", "items": { "$ref": "../ncpdp-schemas.json#/$defs/DynamicStruct" } }
        }
      }
    }
  },
  "required": ["Header", "Patient", "Claims"]
}
